          "required": false
        }
      ]
    }
  ],
  "scripts": {
    "build": "vici build",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@vicinae/api": "0.28.2",
    "react": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "typescript": "^5.9"
  }
}
