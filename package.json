{
  "name": "layouter",
  "title": "Layouter",
  "description": "Launch a development workspace",
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "author": "masterpiece",
  "icon": "icon.png",
  "commands": [
    {
      "name": "layouter",
      "title": "Layouter",
